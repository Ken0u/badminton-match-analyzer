{
  "name": "@badminton/frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "build:foundation": "vite build --mode foundation",
    "test": "node scripts/test.mjs",
    "test:delivery": "node --test tests/stage.test.mjs",
    "contract:generate": "node scripts/contract.mjs --write",
    "contract:check": "node scripts/contract.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
